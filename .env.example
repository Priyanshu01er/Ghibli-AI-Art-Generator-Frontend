# Environment for the Ghibli AI frontend (built with Vite).
# Copy to .env (or .env.local, which is git-ignored) and adjust.
#
# Vite only exposes variables prefixed with VITE_ , read via import.meta.env.
# It inlines them at BUILD time -- restart the dev server after editing.
# These values end up in the shipped JS bundle, so never put a secret here.
#
# Base URL of the ghbliapi backend, no trailing slash.
# Defaults to http://localhost:8080 in src/services/apiClient.js if unset.
VITE_API_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Deployment (Vercel)
# ---------------------------------------------------------------------------
# Set the SAME variable as a project Environment Variable in the Vercel dashboard, pointing
# at the Render service:
#
#   VITE_API_BASE_URL=https://ghbliai-be.onrender.com
#
# That is the only frontend-side change a deployment needs. A real environment variable takes
# priority over any .env file on disk, so the localhost value above cannot leak into a Vercel
# build. Because Vite inlines it, changing it in the dashboard requires a REDEPLOY -- a
# restart is not enough, the value is baked into the bundle.
#
# The matching backend side is CORS_ALLOWED_ORIGINS on Render, which must list this app's
# Vercel origin. Routing for direct visits to /create, /history etc. is handled by
# vercel.json; without its rewrite those URLs 404 on refresh.
