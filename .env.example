# ---------------------------------------------------------------------------
# Example environment for ghbli-art-generator (Create React App).
#
# Copy to `.env` (or `.env.local`, which is already git-ignored) and adjust.
#
# CRA only exposes variables prefixed with REACT_APP_, and it inlines them at
# BUILD time — restart `npm start` after any change here. VITE_* names and
# import.meta.env do NOT work with react-scripts 5.
#
# These values end up in the shipped JS bundle, so never put a secret here.
# ---------------------------------------------------------------------------

# Base URL of the ghbliapi backend, no trailing slash.
# Defaults to http://localhost:8080 in src/services/apiClient.js if unset.
REACT_APP_API_BASE_URL=http://localhost:8080
